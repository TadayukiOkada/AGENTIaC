{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backend catalogue lifecycle, independent of runtime identity",
  "type": "object",
  "required": ["version", "backends"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "backends": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["catalog_status", "reason", "evidence"],
        "additionalProperties": false,
        "properties": {
          "catalog_status": {"enum": ["declared", "archived"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "pattern": "^docs/(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.md$"},
          "retention_refs": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["node", "state", "handle"],
              "additionalProperties": false,
              "properties": {
                "node": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
                "state": {"enum": ["quarantine", "retired"]},
                "handle": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
              }
            }
          }
        }
      }
    }
  }
}
