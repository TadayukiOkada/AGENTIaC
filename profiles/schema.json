{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentiac model profile",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "repo",
    "revision",
    "upstream",
    "quantization",
    "nodes",
    "files",
    "entrypoint",
    "backend"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "repo": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "enum": [
          "orin",
          "spark",
          "rtx3090",
          "rtx4080",
          "rtx3050-laptop"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "context",
        "slots"
      ],
      "properties": {
        "name": {
          "enum": [
            "llama.cpp",
            "infernix"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "context": {
          "type": "integer",
          "minimum": 16384
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "llama.cpp"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "slots": {
                "maximum": 3
              }
            }
          }
        }
      ]
    },
    "license_review": {
      "type": "object",
      "required": [
        "status",
        "decided_by",
        "decided_at",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "manual-approved"
        },
        "decided_by": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decided_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
